# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets / dynaconf
.secrets.*
secrets.*

# Node / React / Vite
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/.playwright/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# Compiled JS emitted next to the TS sources.
# The frontend build script is "tsc && vite build"; tsc had no noEmit/outDir,
# so a plain build dropped a .js copy of every .ts/.tsx file into src/.
# tsconfig.json now sets "noEmit": true - this is a second line of defence.
frontend/src/**/*.js
!frontend/src/**/*.d.ts

# Env
.env
.env.local
.env.*.local
*.env.local

