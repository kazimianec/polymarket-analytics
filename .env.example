# Local dev environment — controls which [section] in settings.toml is loaded.
# Each developer sets this to their own section (e.g. dev_ak_mac, dev_js).
ENV_FOR_DYNACONF=dev_ak_mac

# Deployment target — controls which [section] in deploy.toml is loaded inside containers.
# Values: docker (default), ci, production
DEPLOY_ENV=docker

# --- Ports ---
# Change these if the defaults conflict with other services on your machine.
# These values are also used to build the backend CORS allowlist automatically.

# Backend dev server port (uvicorn, used by `make dev-backend`)
BACKEND_PORT=8000
# API proxy target for the Vite dev server — must match BACKEND_PORT
VITE_API_TARGET=http://localhost:8000
# Backend port exposed on the host when running via docker-compose
BACKEND_HOST_PORT=8001

# Frontend dev server port (Vite, used by `make dev-frontend`)
VITE_PORT=5173
# Frontend port exposed on the host when running via docker-compose
FRONTEND_HOST_PORT=5174

# --- Database (Make / psql tooling only) ---
# These are standard PostgreSQL env vars — psql reads them automatically.
# They use the PG* prefix so dynaconf does NOT pick them up.
# The application reads its own DB config from backend/settings.toml + .secrets.toml.

# Cloud SQL instance name (used by `make db-proxy`)
CLOUDSQL_INSTANCE=shared-infra-prod-490809:europe-west1:main-postgres-dev

# GCP project (used by `make db-auth`)
GCLOUD_PROJECT=shared-infra-prod-490809

PGHOST=127.0.0.1
PGPORT=5435
PGDATABASE=cities

# cities_dba for admin/schema tasks, cities_ro for read-only inspection
PGUSER=cities_dba

# Password for PGUSER — never commit this value
PGPASSWORD=
